{
  "name": "todo-app",
  "version": "2.0.0",
  "description": "Todo app with due dates & priorities, React frontend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build",
    "db:up": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:reset": "docker compose down -v",
    "db:seed": "node scripts/seed.js",
    "db:migrate": "npm run db:up && npm run db:seed"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.0"
  }
}
